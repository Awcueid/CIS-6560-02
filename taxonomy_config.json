{
  "taxonomy_name": "Content-Aware Vulnerability Prioritization Taxonomy",
  "version": "1.0",
  "dimensions": {
    "severity": {
      "weight": 0.40,
      "type": "numeric_multiplier",
      "multiplier": 10
    },
    "exploitation_context": {
      "weight": 0.15,
      "type": "categorical",
      "mappings": {
        "Active": 100,
        "In the Wild": 100,
        "PoC": 50,
        "None": 0
      },
      "default": 0
    },
    "exposure_classification": {
      "weight": 0.10,
      "type": "categorical",
      "mappings": {
        "External": 100,
        "Remote": 100,
        "Internal": 40,
        "Local": 20
      },
      "default": 0
    },
    "patch_difficulty": {
      "weight": 0.10,
      "type": "categorical",
      "mappings": {
        "High": 100,
        "Medium": 60,
        "Low": 20
      },
      "default": 50
    },
    "compensating_controls": {
      "weight": 0.10,
      "type": "context_modifier",
      "rules": {
        "missing_control_score": 100,
        "existing_control_score": 30,
        "internet_facing_override_score": 100
      }
    },
    "asset_criticality": {
      "weight": 0.10,
      "type": "asset_ratio"
    },
    "data_status": {
      "weight": 0.05,
      "type": "categorical",
      "mappings": {
        "Active": 100,
        "Open": 100,
        "In Progress": 70,
        "Accepted": 0,
        "Risk Accepted": 0
      },
      "default": 100
    }
  }
}
