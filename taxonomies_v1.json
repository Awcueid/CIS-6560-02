{
  "taxonomy_name": "CIS6560_Risk_Scoring_Taxonomy",
  "version": "1.0.0",
  "last_updated": "2026-09-30",
  "scoring_dimensions": {
    "severity": {
      "source": "NVD API (CVSS/CVE)",
      "scale": {"min": 0, "max": 10},
      "weight": 0.40
    },
    "exploited_in_the_wild": {
      "source": "CISA KEV, Vendor Advisories, Threat Intel",
      "scale": {"min": 0, "max": 2},
      "weight": 0.15
    },
    "poc_exploit_availability": {
      "source": "Exploit-DB, GitHub, Security Research",
      "scale": {"min": 0, "max": 2},
      "weight": 0.10
    },
    "patch_difficulty": {
      "source": "Vendor Advisories",
      "scale": {"min": 1, "max": 3},
      "weight": 0.10
    },
    "compensating_controls": {
      "source": "Firewall Rules, Network Segmentation, EDR, IPS",
      "scale": {"min": 0, "max": 3},
      "weight": 0.10
    },
    "asset_criticality": {
      "source": "Asset Classification / Host Tagging",
      "scale": {"min": 1, "max": 4},
      "weight": 0.10
    },
    "risk_acceptance_transfer": {
      "source": "Approved Risk Register, Cyber Insurance",
      "scale": {"min": 0, "max": 2},
      "weight": 0.05
    }
  },
  "score_interpretation": [
    {
      "risk_level": "Low",
      "range": {"min": 1, "max": 6},
      "interpretation": "Low likelihood and limited business impact. Routine monitoring is sufficient."
    },
    {
      "risk_level": "Medium",
      "range": {"min": 7, "max": 12},
      "interpretation": "Moderate risk requiring planned remediation and monitoring."
    },
    {
      "risk_level": "High",
      "range": {"min": 13, "max": 18},
      "interpretation": "Significant risk with potential operational or security impact. Prioritized remediation is recommended."
    },
    {
      "risk_level": "Critical",
      "range": {"min": 19, "max": 24},
      "interpretation": "Severe risk requiring immediate attention and remediation."
    }
  ]
}
